# Postgres connection (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Public origin (used to redirect back to the frontend after OAuth)
APP_ORIGIN=http://localhost:3000

# API server port (frontend stays on 3000)
API_PORT=3001
